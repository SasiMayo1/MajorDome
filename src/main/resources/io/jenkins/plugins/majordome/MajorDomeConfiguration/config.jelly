<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="MajorDome">
    <f:entry field="enabled">
      <f:checkbox title="Enable the AI assistant" default="true"/>
    </f:entry>
    <f:dropdownDescriptorSelector field="provider" title="Model provider"/>
    <f:entry field="allowBuildLogs">
      <f:checkbox title="Allow sending build console logs (with secrets redacted) to the model provider" default="true"/>
    </f:entry>
    <f:entry field="showFloatingWidget">
      <f:checkbox title="Show the chat button on every page" default="true"/>
    </f:entry>
    <f:advanced>
      <f:entry title="Max tool steps per message" field="maxToolIterations">
        <f:number default="10" min="1" max="50"/>
      </f:entry>
      <f:entry title="Proposal expiry (minutes)" field="proposalTtlMinutes">
        <f:number default="10" min="1" max="120"/>
      </f:entry>
    </f:advanced>
  </f:section>
</j:jelly>
